    },
    {
      "id": 6,
      "title": "Live Application Logs",
      "type": "logs",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{service=\"backend-api\"}",
          "refId": "A"
        }
      ]
    }
